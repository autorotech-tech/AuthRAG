# LiveKit Cloud: https://cloud.livekit.io/
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram STT (низкая задержка): https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs TTS: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Gemini через плагин Google: задаётся GOOGLE_API_KEY или алиас ниже
GOOGLE_API_KEY=
# или
GEMINI_API_KEY=

# Variant B — pipeline (Deepgram + Gemini Flash + ElevenLabs Flash TTS)
GEMINI_MODEL=gemini-2.5-flash
DEEPGRAM_MODEL=nova-3
ELEVENLABS_MODEL=eleven_flash_v2_5

# Variant A — Gemini Live native audio (see agent_gemini_live.py)
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_VOICE=Puck
